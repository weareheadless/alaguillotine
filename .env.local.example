# ─── Appwrite (Self-Hosted) ──────────────────────────────────────────────────
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost:4000/v1          # Your Appwrite endpoint
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id                 # Your Appwrite project ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id               # Your Appwrite database ID
NEXT_PUBLIC_APPWRITE_MESSAGES_COLLECTION_ID=messages            # Collection for messages
APPWRITE_API_KEY=your_appwrite_api_key                          # Admin API key (server-side)

# ─── OpenAI Moderation ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key                           # OpenAI API key for moderation

# ─── Solana ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # Solana RPC endpoint
NEXT_PUBLIC_SOLANA_RECEIVER_WALLET=your_solana_wallet_address   # Treasury wallet to receive CHOP payments

# ─── CHOP Token (SPL) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CHOP_MINT=DTPZyd2HnDmLQfCGkFJ7ajVbw77maUVT7QVLE7Ltpump  # CHOP token mint address
NEXT_PUBLIC_CHOP_DECIMALS=6                                          # CHOP token decimals
CHOP_TREASURY_SECRET_KEY=your_treasury_wallet_base58_secret          # Server wallet secret key (base58) — funded with CHOP
CHOP_BURN_ADDRESS=11111111111111111111111111111111                   # Burn address (System Program ID)
