# Admin dashboard (/admin) — shared key that unlocks the Ada control room.
# A single strong key you keep secret; it signs an httpOnly cookie on login.
ADMIN_KEY=
# Key forwarded to the private Python admin API. Set it to the same value as
# ADMIN_API_KEY there, or leave blank to reuse ADMIN_KEY.
ADMIN_UPSTREAM_KEY=

# Ada's chat and research upstreams (VPS).
CHAT_UPSTREAM=https://api.helloada.app/ada
ADA_KEY=
DEEPSEEK_API_KEY=
SITE_AGENT_LLM_API_KEY=

