[Unit]
Description=FuckYouElon Next.js App
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/FYE
Environment=NODE_ENV=production
EnvironmentFile=/FYE/.env.local
ExecStart=/usr/local/bin/node /FYE/node_modules/next/dist/bin/next start -p 3002
Restart=always
RestartSec=2
StandardOutput=append:/FYE/logs/fye-app.log
StandardError=append:/FYE/logs/fye-app-error.log

[Install]
WantedBy=multi-user.target
