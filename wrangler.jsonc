{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "alaguillotine",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://alaguillotine.com"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "830aa6e6-d1bb-4cfa-98cf-b7c8e5284755",
      "database_name": "alaguillotine-content"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *", "15 */3 * * *", "30 */12 * * *"]
  }
}
